# --- Database (Vercel Postgres / Neon / Supabase / any Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/byms?schema=public&sslmode=require"
# Some providers (Vercel Postgres, Neon) also need a direct (non-pooled) URL for migrations
DIRECT_URL="postgresql://user:password@host:5432/byms?schema=public&sslmode=require"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Vercel Blob (file storage for payment receipts / images) ---
# Create in Vercel dashboard -> Storage -> Blob, or `vercel blob store add`
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
