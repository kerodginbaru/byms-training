generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(REGISTRATION_ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
}

model Schedule {
  id            String         @id @default(cuid())
  name          String
  days          String[]
  session       SessionName
  startTime     String
  endTime       String
  capacity      Int            @default(30)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]

  @@index([isActive])
}

model Registration {
  id                  String         @id @default(cuid())
  registrationNumber  String         @unique
  fullName            String
  phone               String
  applicantType       ApplicantType
  studentYear         StudentYear?
  department          String?
  scheduleId          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  agreedToRegulations Boolean        @default(false)
  packageType         PackageType    @default(REGULAR)
  preferredTime       String?
  auditLogs           AuditLog[]
  schedule            Schedule?      @relation(fields: [scheduleId], references: [id])
  uploadedFiles       UploadedFile[]

  @@index([phone])
  @@index([scheduleId])
  @@index([createdAt])
  @@index([registrationNumber])
}

model RegistrationCounter {
  year    Int @id
  current Int @default(0)
}

model UploadedFile {
  id               String        @id @default(cuid())
  kind             FileKind      @default(DOCUMENT)
  registrationId   String?
  storageKey       String
  originalFilename String
  mimeType         String
  size             Int
  createdAt        DateTime      @default(now())
  registration     Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([kind])
}

model Settings {
  id                          Int      @id @default(1)
  institutionNameAm           String   @default("ቤተ-ያሬድ መንፈሳዊ መሳርያዎች ማሰልጠኛ")
  institutionNameEn           String   @default("Bete-Yared Spiritual Instruments Training Center")
  phone                       String   @default("+251993184466")
  address                     String   @default("ጉብሬ፣ ኢትዮጵያ")
  heroTitle                   String   @default("ቤተ-ያሬድ መንፈሳዊ መሳርያዎች ማሰልጠኛ")
  heroDescription             String   @default("ኦንላይን በመመዝገብ የስልጠና መርሃ ግብራችንን ይቀላቀሉ።")
  morningStartTime            String   @default("12:00")
  morningEndTime              String   @default("13:30")
  afternoonStartTime          String   @default("12:00")
  afternoonEndTime            String   @default("13:30")
  registrationOpen            Boolean  @default(true)
  maxUploadSizeMb             Int      @default(5)
  duplicatePhoneScheduleBlock Boolean  @default(true)
  logoFileKey                 String?
  heroImageFileKey            String?
  aboutImageFileKey           String?
  updatedAt                   DateTime @updatedAt
  contactPersonName           String   @default("መምህር ዲያቆን አሸናፊ")
  contactPersonPhone          String   @default("0993184466")
  location                    String   @default("ጉብሬ ረፈራል ሆስፒታል ጀርባ")
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  action         String
  entityType     String
  entityId       String
  registrationId String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  registration   Registration? @relation(fields: [registrationId], references: [id])
  user           AdminUser?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum AdminRole {
  SUPER_ADMIN
  REGISTRATION_ADMIN
  VIEWER
}

enum ApplicantType {
  STUDENT
  EMPLOYEE
}

enum PackageType {
  REGULAR
  SPECIAL
  HOME_TO_HOME
  KRAR
}

enum StudentYear {
  REMEDIAL
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
}

enum SessionName {
  MORNING
  AFTERNOON
}

enum FileKind {
  DOCUMENT
  LOGO
  HERO_IMAGE
  ABOUT_IMAGE
  GALLERY_IMAGE
  CERTIFICATE_PHOTO
  CERTIFICATE
}
